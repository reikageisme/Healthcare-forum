# Database
POSTGRES_HOST=db
POSTGRES_DB=healthcare_forum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only-change-me
# Used by the optional docker-compose.db.yml overlay. For an external
# development database, replace this whole URL with the real dev connection.
DATABASE_URL=postgresql://postgres:local-dev-only-change-me@db:5432/healthcare_forum

# JWT — must be at least 32 characters when NODE_ENV=production,
# or the backend refuses to start rather than signing with a weak key.
# Development placeholder only; production requires a unique random secret
# with at least 32 characters.
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
# Must list real origins. "*" together with credentials is rejected by
# browsers and unsafe; if set to "*" the app falls back to localhost only.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
PROJECT_NAME=Healthcare Forum
# Địa chỉ công khai của diễn đàn — dùng cho sitemap.xml và robots.txt
SITE_URL=http://localhost:3000

# Mạng lưới các trang anh em, hiện thành thẻ ở sidebar phải.
# Trang nào có url trùng SITE_URL sẽ được đánh dấu "Đang xem", nên mọi trang
# trong mạng lưới dùng chung đúng một cấu hình này.
# Để trống NETWORK_SITES thì cả thẻ không hiện.
NETWORK_NAME=Mạng lưới SứcKhỏeVN
NETWORK_TAGLINE=Hệ thống thông tin y tế — mỗi chuyên khoa một cộng đồng.
# Dạng gọn: "Tên|https://...,Tên khác|https://..."
# Hoặc JSON: [{"name":"MedicVN","url":"https://medicvn.com","description":"..."}]
NETWORK_SITES=

# Chân trang. Liên kết pháp lý dùng cùng định dạng "Tên|url".
# Để trống thì mục đó không hiện — không tạo liên kết dẫn tới trang trắng.
# Ví dụ: Điều khoản sử dụng|/dieu-khoan,Chính sách quyền riêng tư|/quyen-rieng-tu
FOOTER_LINKS=
CONTACT_EMAIL=
NODE_ENV=development
# Set to true only when debugging; it logs every SQL statement with its
# bound parameters, which includes emails and password hashes.
DB_ECHO=false
# SQL_ECHO is accepted for compatibility with older deployments.
SQL_ECHO=false

# First admin account, created on boot when it does not exist yet.
# Leave ADMIN_PASSWORD empty to skip the bootstrap entirely.
ADMIN_EMAIL=admin@health.vn
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Frontend uses same-origin /api and /uploads proxies; no public API URL is needed.
